# ═══════════════════════════════════════════════════════════════════════════
# ARShop Web — variables del cliente
# Copia a .env.local (nunca commitear)
# ═══════════════════════════════════════════════════════════════════════════

# URL del backend NestJS. Server-side se usa directo; en el browser el API
# viaja por /api gracias a los rewrites de next.config.mjs (necesario para
# que las cookies httpOnly del auth sean same-site).
BACKEND_URL=http://localhost:4000

# Supabase (Auth lo hace el cliente directo contra Supabase; no pasa por la API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# Stripe (publishable key, segura en el cliente)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
