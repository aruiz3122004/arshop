# ═══════════════════════════════════════════════════════════════════════════
# ARShop API — Variables de entorno
# Copia este archivo a .env (nunca lo commitees)
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Orígenes permitidos por CORS (coma-separados, sin espacios)
CORS_ORIGIN=http://localhost:3000
# URL pública del frontend (para redirect de recuperación de contraseña)
APP_URL=http://localhost:3000
# Si true, el usuario debe confirmar email antes de poder iniciar sesión.
# Dejar en false en desarrollo; activar en producción.
REQUIRE_EMAIL_VERIFY=false

# ── Supabase ─────────────────────────────────────────────────────────────
# Dashboard: https://app.supabase.com/project/<ref>/settings/api
SUPABASE_URL=https://<ref>.supabase.co
# anon key — se puede exponer al cliente
SUPABASE_ANON_KEY=
# service_role key — NUNCA exponer al cliente, uso exclusivo del backend
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret del proyecto (Settings → API → JWT Secret) — para verificar tokens
SUPABASE_JWT_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_
# Secret del webhook — se obtiene al configurar el endpoint
# o localmente con: stripe listen --forward-to localhost:4000/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_
# Moneda en minúsculas, códigos ISO 4217
STRIPE_CURRENCY=cop

# ── Resend ───────────────────────────────────────────────────────────────
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_
# Sandbox: usa onboarding@resend.dev — solo envía al email registrado en la
# cuenta de Resend. Para producción, verifica un dominio propio en
# https://resend.com/domains y cambia esta línea.
RESEND_FROM="ARShop <onboarding@resend.dev>"
# Opcional: redirige TODOS los correos salientes a este email, útil cuando
# estás en modo sandbox (deja vacío en producción para que lleguen al cliente).
RESEND_SANDBOX_TO=

# ── Redis (BullMQ) ───────────────────────────────────────────────────────
# Solo el hostname, SIN https:// ni rediss://
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Upstash y la mayoría de managed Redis exigen TLS. En local, false o vacío.
REDIS_TLS=false

# ── Rate limiting (defaults) ─────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT_DEFAULT=120
# Límite estricto para /auth/* y /orders (checkout): 5 intentos por minuto
THROTTLE_LIMIT_STRICT=5

# ── Setup (one-time token para crear primer admin) ───
# Generar con: openssl rand -base64 32
# Úsalo una sola vez en POST /auth/promote-admin, luego elimínalo del .env
ADMIN_SETUP_TOKEN=

# ── Modo demo ───────────────────────────────────────────────────────────
# Obligatorio en producción: /auth/demo-sign-in permite entrar como ADMIN
# con credenciales fijas del repositorio. El sandbox de /cuenta corre en el
# navegador (demo-store.ts) y NO depende de este flag.
# Si se omite se asume "true" (fail-closed); en producción, omitirlo o
# poner "false" hace fallar el arranque a propósito.
DEMO_MODE_DISABLED=true

# ── Ventana de confirmación de entregas simuladas ─────────────────────────
# Cuando el repartidor no obtiene QR ni el código del cliente, la entrega
# queda PENDING_CLIENT (no DELIVERED). A las N horas se le envía un
# recordatorio push y, al vencer el plazo, el pedido pasa a DISPUTED para
# revisión de un admin. Nunca se auto-acepta.
SIMULATED_DELIVERY_HOURS=48
SIMULATED_DELIVERY_REMINDER_HOURS=24

# -- Facturación electrónica (opcional) --------------------------------------
# Firma los enlaces públicos de facturas (/api/invoices/public/:id/:token).
# Si se omite se reutiliza QR_HMAC_SECRET. Definirlo permite rotar los
# enlaces de facturas sin invalidar los QR de entrega.
# Generar con: openssl rand -hex 32
INVOICE_PUBLIC_SECRET=
